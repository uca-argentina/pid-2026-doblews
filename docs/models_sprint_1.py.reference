"""Data model for Sprint 1 — SQLAlchemy 2.0 declarative mapping.

Reference implementation for the schema described in `modelo-datos-sprint-1.md`
and `ddl-sprint-1.sql`. Drop these classes into the backend (one module per
aggregate, e.g. `app/models/usuario.py`) and keep `Base` in `app/db/base.py`.

Scope: HU-0 through HU-5 only.
"""

from __future__ import annotations

from datetime import date, datetime
from decimal import Decimal
from typing import Optional

from sqlalchemy import (
    BigInteger,
    Boolean,
    CheckConstraint,
    Date,
    DateTime,
    ForeignKey,
    ForeignKeyConstraint,
    Identity,
    Index,
    MetaData,
    Numeric,
    String,
    Text,
    UniqueConstraint,
    func,
    text,
)
from sqlalchemy.orm import (
    DeclarativeBase,
    Mapped,
    foreign,
    mapped_column,
    relationship,
)


# -----------------------------------------------------------------------------
# Base
#
# The naming convention MUST be in place before the first autogenerated Alembic
# revision. Without it Postgres names constraints on its own, and a later
# migration cannot reference an anonymous constraint in order to drop or alter
# it. Adding it after the fact means renaming constraints by hand in production.
# -----------------------------------------------------------------------------
NAMING_CONVENTION = {
    "ix": "ix_%(table_name)s_%(column_0_N_name)s",
    "uq": "uq_%(table_name)s_%(column_0_N_name)s",
    "ck": "ck_%(table_name)s_%(constraint_name)s",
    "fk": "fk_%(table_name)s_%(column_0_name)s",
    "pk": "pk_%(table_name)s",
}


class Base(DeclarativeBase):
    metadata = MetaData(naming_convention=NAMING_CONVENTION)


class TimestampMixin:
    """created_at / updated_at maintained by the database.

    `server_default` and `server_onupdate` (backed by the `set_updated_at`
    trigger, see the DDL) keep the values correct for writes that do not go
    through the ORM: seeds, data migrations, manual fixes.
    """

    created_at: Mapped[datetime] = mapped_column(
        DateTime(timezone=True), nullable=False, server_default=func.now()
    )
    updated_at: Mapped[datetime] = mapped_column(
        DateTime(timezone=True),
        nullable=False,
        server_default=func.now(),
        onupdate=func.now(),
    )


def pk() -> Mapped[int]:
    return mapped_column(BigInteger, Identity(always=True), primary_key=True)


# -----------------------------------------------------------------------------
# rol / usuario / usuario_rol  (HU-1, HU-2)
# -----------------------------------------------------------------------------
class Rol(Base):
    """Closed catalogue, loaded by seed migration: admin | arquitecto | cliente."""

    __tablename__ = "rol"

    id: Mapped[int] = pk()
    codigo: Mapped[str] = mapped_column(String(30), nullable=False, unique=True)
    nombre: Mapped[str] = mapped_column(String(60), nullable=False)
    descripcion: Mapped[Optional[str]] = mapped_column(Text)

    usuarios: Mapped[list["UsuarioRol"]] = relationship(back_populates="rol")


class Usuario(Base, TimestampMixin):
    __tablename__ = "usuario"
    __table_args__ = (
        CheckConstraint("position('@' in email) > 1", name="email_formato"),
        CheckConstraint("email = lower(email)", name="email_lower"),
        # Case-insensitive and GLOBAL, inactive users included: the email is the
        # login identity, so reusing it would make re-activation ambiguous.
        Index(
            "uq_usuario_email_lower",
            func.lower(text("email")),
            unique=True,
        ),
    )

    id: Mapped[int] = pk()
    nombre: Mapped[str] = mapped_column(String(120), nullable=False)
    email: Mapped[str] = mapped_column(String(255), nullable=False)
    password_hash: Mapped[str] = mapped_column(String(255), nullable=False)
    is_active: Mapped[bool] = mapped_column(
        Boolean, nullable=False, server_default=text("true")
    )

    roles: Mapped[list["UsuarioRol"]] = relationship(
        back_populates="usuario", cascade="all, delete-orphan"
    )
    membresias: Mapped[list["ObraMiembro"]] = relationship(back_populates="usuario")

    @property
    def codigos_rol(self) -> set[str]:
        """Role codes, to embed in the JWT at login and skip the JOIN per request."""
        return {ur.rol.codigo for ur in self.roles}


class UsuarioRol(Base):
    """N:M. The same person can be admin and arquitecto, or arquitecto in their
    own projects and cliente in a colleague's."""

    __tablename__ = "usuario_rol"
    # The PK already covers lookups by usuario_id; this index is for the reverse
    # direction ("every user with the cliente role" -> the dropdown in HU-3).
    __table_args__ = (Index("ix_usuario_rol_rol", "rol_id"),)

    usuario_id: Mapped[int] = mapped_column(
        BigInteger, ForeignKey("usuario.id", ondelete="CASCADE"), primary_key=True
    )
    rol_id: Mapped[int] = mapped_column(
        BigInteger, ForeignKey("rol.id", ondelete="RESTRICT"), primary_key=True
    )
    asignado_en: Mapped[datetime] = mapped_column(
        DateTime(timezone=True), nullable=False, server_default=func.now()
    )

    usuario: Mapped["Usuario"] = relationship(back_populates="roles")
    rol: Mapped["Rol"] = relationship(back_populates="usuarios", lazy="joined")


# -----------------------------------------------------------------------------
# obra / obra_miembro  (HU-3)
# -----------------------------------------------------------------------------
class Obra(Base, TimestampMixin):
    __tablename__ = "obra"
    __table_args__ = (
        CheckConstraint("length(btrim(nombre)) > 0", name="nombre_no_vacio"),
    )

    id: Mapped[int] = pk()
    nombre: Mapped[str] = mapped_column(String(150), nullable=False)
    descripcion: Mapped[Optional[str]] = mapped_column(Text)
    direccion: Mapped[Optional[str]] = mapped_column(String(255))
    fecha_estimada_inicio: Mapped[Optional[date]] = mapped_column(Date)

    # Business attribute, not an access rule: at most one cliente per obra, and
    # it shows up in the listing. Service layer must check the user has the
    # 'cliente' role — an FK cannot look into usuario_rol.
    cliente_id: Mapped[Optional[int]] = mapped_column(
        BigInteger, ForeignKey("usuario.id", ondelete="RESTRICT"), index=True
    )
    created_by: Mapped[int] = mapped_column(
        BigInteger, ForeignKey("usuario.id", ondelete="RESTRICT"), nullable=False
    )
    is_active: Mapped[bool] = mapped_column(
        Boolean, nullable=False, server_default=text("true")
    )

    cliente: Mapped[Optional["Usuario"]] = relationship(foreign_keys=[cliente_id])
    creador: Mapped["Usuario"] = relationship(foreign_keys=[created_by])
    miembros: Mapped[list["ObraMiembro"]] = relationship(
        back_populates="obra", cascade="all, delete-orphan"
    )
    componentes: Mapped[list["ComponenteConstructivo"]] = relationship(
        back_populates="obra", cascade="all, delete-orphan"
    )


class ObraMiembro(Base):
    """Access control for HU-3: "I only see the obras I am a member of".

    N:M because a two-architect studio shares obras from day one. When an obra
    is created the backend MUST insert its creator here, in the same
    transaction, or the architect ends up unable to see what they just created.
    """

    __tablename__ = "obra_miembro"
    __table_args__ = (
        CheckConstraint(
            "rol_en_obra in ('responsable', 'colaborador')", name="rol_valido"
        ),
        # At most one responsable per obra.
        Index(
            "uq_obra_responsable",
            "obra_id",
            unique=True,
            postgresql_where=text("rol_en_obra = 'responsable'"),
        ),
        # "My obras" — the most frequent query in the whole application.
        Index("ix_obra_miembro_usuario", "usuario_id"),
    )

    obra_id: Mapped[int] = mapped_column(
        BigInteger, ForeignKey("obra.id", ondelete="CASCADE"), primary_key=True
    )
    usuario_id: Mapped[int] = mapped_column(
        BigInteger, ForeignKey("usuario.id", ondelete="RESTRICT"), primary_key=True
    )
    rol_en_obra: Mapped[str] = mapped_column(
        String(20), nullable=False, server_default=text("'colaborador'")
    )
    fecha_alta: Mapped[datetime] = mapped_column(
        DateTime(timezone=True), nullable=False, server_default=func.now()
    )

    obra: Mapped["Obra"] = relationship(back_populates="miembros")
    usuario: Mapped["Usuario"] = relationship(back_populates="membresias")


# -----------------------------------------------------------------------------
# unidad_medida  (HU-0)
# -----------------------------------------------------------------------------
class UnidadMedida(Base):
    """Closed catalogue loaded by seed. No CRUD screen (HU-0)."""

    __tablename__ = "unidad_medida"
    __table_args__ = (
        CheckConstraint(
            "magnitud in ('superficie', 'volumen', 'longitud', 'masa', 'conteo')",
            name="magnitud_valida",
        ),
    )

    id: Mapped[int] = pk()
    codigo: Mapped[str] = mapped_column(String(10), nullable=False, unique=True)
    nombre: Mapped[str] = mapped_column(String(60), nullable=False)
    abreviatura: Mapped[str] = mapped_column(String(10), nullable=False)
    # Not required by Sprint 1. Filled for free by the seed, and without it there
    # is no way to tell that m2 -> bolsa needs a factor while m2 -> m3 is
    # meaningless, once the recipe module lands.
    magnitud: Mapped[str] = mapped_column(String(20), nullable=False)
    is_active: Mapped[bool] = mapped_column(
        Boolean, nullable=False, server_default=text("true")
    )


# -----------------------------------------------------------------------------
# material  (HU-4) — global catalogue, not per obra
# -----------------------------------------------------------------------------
class Material(Base, TimestampMixin):
    __tablename__ = "material"
    __table_args__ = (
        CheckConstraint("length(btrim(nombre)) > 0", name="nombre_no_vacio"),
        CheckConstraint("precio_referencia >= 0", name="precio_no_negativo"),
        CheckConstraint("moneda ~ '^[A-Z]{3}$'", name="moneda_iso"),
        # PARTIAL uniqueness: only among active rows. Unlike the email, a
        # material name is a label, not an identity — a material deleted by
        # mistake has to be re-creatable.
        Index(
            "uq_material_nombre_activo",
            func.lower(text("nombre")),
            unique=True,
            postgresql_where=text("is_active"),
        ),
    )

    id: Mapped[int] = pk()
    nombre: Mapped[str] = mapped_column(String(200), nullable=False)
    unidad_medida_id: Mapped[int] = mapped_column(
        BigInteger, ForeignKey("unidad_medida.id", ondelete="RESTRICT"), nullable=False
    )
    # NUMERIC, never float: rounding error compounds through a budget.
    precio_referencia: Mapped[Decimal] = mapped_column(Numeric(14, 2), nullable=False)
    # ISO 4217. Column now, conversion logic later — so historical prices never
    # have to be reinterpreted.
    moneda: Mapped[str] = mapped_column(
        String(3), nullable=False, server_default=text("'ARS'")
    )
    precio_actualizado_en: Mapped[Optional[datetime]] = mapped_column(
        DateTime(timezone=True)
    )
    is_active: Mapped[bool] = mapped_column(
        Boolean, nullable=False, server_default=text("true")
    )

    unidad_medida: Mapped["UnidadMedida"] = relationship(lazy="joined")


# -----------------------------------------------------------------------------
# componente_constructivo  (HU-5)
# -----------------------------------------------------------------------------
class ComponenteConstructivo(Base, TimestampMixin):
    """Adjacency list. `parent_id` ships in the first migration so the WBS/EDT
    module does not need a migration over live data.

    The composite FK (parent_id, obra_id) -> (id, obra_id) makes it impossible
    for a component to hang off a parent that belongs to a different obra —
    enforced by the database, with no Python validation involved.
    """

    __tablename__ = "componente_constructivo"
    __table_args__ = (
        CheckConstraint("length(btrim(descripcion)) > 0", name="descripcion_no_vacia"),
        CheckConstraint("medida > 0", name="medida_positiva"),
        CheckConstraint(
            "parent_id is null or parent_id <> id", name="no_self_parent"
        ),
        # Target of the composite FK below.
        UniqueConstraint("id", "obra_id", name="uq_componente_id_obra"),
        ForeignKeyConstraint(
            ["parent_id", "obra_id"],
            ["componente_constructivo.id", "componente_constructivo.obra_id"],
            name="fk_componente_parent",
            ondelete="RESTRICT",
        ),
        Index("ix_componente_obra", "obra_id"),
        Index("ix_componente_parent", "parent_id"),
    )

    id: Mapped[int] = pk()
    obra_id: Mapped[int] = mapped_column(
        BigInteger, ForeignKey("obra.id", ondelete="CASCADE"), nullable=False
    )
    parent_id: Mapped[Optional[int]] = mapped_column(BigInteger)
    descripcion: Mapped[str] = mapped_column(String(255), nullable=False)
    medida: Mapped[Decimal] = mapped_column(Numeric(14, 3), nullable=False)
    unidad_medida_id: Mapped[int] = mapped_column(
        BigInteger, ForeignKey("unidad_medida.id", ondelete="RESTRICT"), nullable=False
    )
    is_active: Mapped[bool] = mapped_column(
        Boolean, nullable=False, server_default=text("true")
    )

    obra: Mapped["Obra"] = relationship(back_populates="componentes")
    unidad_medida: Mapped["UnidadMedida"] = relationship(lazy="joined")

    # The join condition is spelled out because the composite FK also carries
    # obra_id, which SQLAlchemy cannot disambiguate on its own for a
    # self-referential relationship.
    hijos: Mapped[list["ComponenteConstructivo"]] = relationship(
        back_populates="parent",
        primaryjoin=lambda: ComponenteConstructivo.id
        == foreign(ComponenteConstructivo.parent_id),
    )
    parent: Mapped[Optional["ComponenteConstructivo"]] = relationship(
        back_populates="hijos",
        remote_side=lambda: [ComponenteConstructivo.id],
        primaryjoin=lambda: ComponenteConstructivo.id
        == foreign(ComponenteConstructivo.parent_id),
    )
