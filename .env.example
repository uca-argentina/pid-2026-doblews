# Postgres for local development (docker compose up -d)
DATABASE_URL=postgresql+psycopg://warchitecture:warchitecture@localhost:5432/warchitecture

# Separate database for the test suite. Tests recreate their schema from scratch
# on every run, so this must never point at the development database.
TEST_DATABASE_URL=postgresql+psycopg://warchitecture:warchitecture@localhost:5432/warchitecture_test

# Password for the accounts created by `python -m app.db.seed_dev`. Development only.
SEED_PASSWORD=warchitecture

JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
